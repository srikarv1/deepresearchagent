diff --git a/gpt_researcher/utils/query_gate.py b/gpt_researcher/utils/query_gate.py
new file mode 100644
--- /dev/null
+++ b/gpt_researcher/utils/query_gate.py
@@ -0,0 +1,31 @@
+"""Optional task-local inner-query hook. No ML/provider dependencies."""
+from contextvars import ContextVar
+
+HOOK_VERSION = 1
+active_gate = ContextVar('adr_inner_query_gate', default=None)
+active_decision = ContextVar('adr_inner_query_decision', default=None)
+
+
+class QueryGateError(RuntimeError):
+    """Fatal gate error; must bypass research's best-effort fallbacks."""
+
+
+def note_search(query):
+    gate = active_gate.get()
+    if gate is not None:
+        gate.searches += 1
+        if active_decision.get() is None:
+            gate.note_planning_query(query)
+
+
+def note_reads(count):
+    gate = active_gate.get()
+    if gate is not None:
+        gate.reads += count
+
+
+def note_retrieval():
+    decision = active_decision.get()
+    if decision is not None:
+        decision['retrieval_invoked'] = True
+        active_gate.get().event('retrieval_invoked', decision)
