+"""browser-owned-cleanup-v1: bounded shutdown of this scrape's processes only.
+No page-work timeout, Chrome-option change, or machine-wide process matching.
+"""
+import threading
+import psutil
+
+VERSION='browser-owned-cleanup-v1'
+
+class OwnedBrowser:
+    def __init__(self,service):
+        self.service=service;self.owned={};self.lock=threading.Lock();self.stop=threading.Event()
+        self.errors=[]
+        self.watcher=threading.Thread(target=self._watch,daemon=True);self.watcher.start()
+
+    def capture(self):
+        process=getattr(self.service,'process',None)
+        if process is None or process.poll() is not None:return
+        try:
+            root=psutil.Process(process.pid)
+            with self.lock:self.owned[(root.pid,root.create_time())]=root
+            for p in root.children(recursive=True):
+                with self.lock:self.owned[(p.pid,p.create_time())]=p
+        except psutil.NoSuchProcess:pass
+        except psutil.Error:self.errors.append('ownership_capture_failed')
+
+    def _watch(self):
+        while not self.stop.wait(.1):self.capture()
+
+    def terminate_owned(self):
+        self.capture()
+        with self.lock:items=list(self.owned.items())
+        live=[]
+        for (pid,born),p in reversed(items):
+            try:
+                if p.is_running() and p.create_time()==born:
+                    p.terminate();live.append(p)
+            except psutil.NoSuchProcess:pass
+            except psutil.Error:self.errors.append('owned_terminate_failed')
+        _,alive=psutil.wait_procs(live,timeout=3)
+        for p in alive:
+            try:
+                # psutil's Process identity protects against PID reuse.
+                if p.is_running():p.kill()
+            except psutil.NoSuchProcess:pass
+            except psutil.Error:self.errors.append('owned_kill_failed')
+        _,alive=psutil.wait_procs(alive,timeout=3)
+        if alive:self.errors.append('owned_process_survived')
+
+    def close(self,driver,timeout=10):
+        self.capture();done=threading.Event();failed=[]
+        def shutdown():
+            try:
+                if driver is not None:driver.quit()
+                else:self.service.stop()
+            except Exception:failed.append(True)
+            finally:done.set()
+        thread=threading.Thread(target=shutdown,daemon=True);thread.start()
+        finished=done.wait(timeout)
+        try:
+            # Capture before root removal, retain descendants even if reparented.
+            with self.lock:survivors=any(p.is_running() for p in self.owned.values())
+            if not finished or failed or survivors:
+                print('BROWSER_CLEANUP_FALLBACK: owned process cleanup',flush=True)
+                self.terminate_owned()
+        finally:
+            self.stop.set();self.watcher.join(timeout=1)
+        if self.errors:print('BROWSER_CLEANUP_INCOMPLETE: manual integrity review required',flush=True)
