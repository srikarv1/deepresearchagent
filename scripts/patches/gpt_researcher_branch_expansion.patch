@@ -0,0 +1,20 @@
+"""Optional pre-recursion hook; default preserves all existing expansion behavior."""
+from contextvars import ContextVar
+
+HOOK_VERSION = 1
+active_expansion = ContextVar('adr_branch_expansion', default=None)
+
+
+def allow_expansion(branch_id, remaining_depth):
+    policy = active_expansion.get()
+    if policy is None:
+        return True
+    # Controller errors must never terminate ordinary research or prune by accident.
+    try:
+        return policy.allow(branch_id, remaining_depth)
+    except Exception:
+        try:
+            policy.failed_open(branch_id, remaining_depth)
+        except Exception:
+            pass
+        return True
