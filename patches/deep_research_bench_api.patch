+# TLS12_PATCH : on some networks large TLS 1.3 request bodies are
+# cut off (SSL UNEXPECTED_EOF); pin judge calls to TLS 1.2. Request content is unchanged.
+import ssl as _ssl
+from requests.adapters import HTTPAdapter as _HTTPAdapter
+class _TLS12Adapter(_HTTPAdapter):
+    def init_poolmanager(self, *a, **k):
+        ctx = _ssl.create_default_context()
+        ctx.maximum_version = _ssl.TLSVersion.TLSv1_2
+        k["ssl_context"] = ctx
+        return super().init_poolmanager(*a, **k)
+_JUDGE_SESSION = requests.Session()
+_JUDGE_SESSION.mount("https://", _TLS12Adapter())
 
