# ── Agent-side model (OpenAI-compatible) ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ADR_LLM_MODEL=gpt-4.1-mini

# ── DeepResearch Bench judges (RACE + FACT) ───────────────────────────────────
# RACE and FACT call Gemini via deep_research_bench/utils/api.py, so this is the
# judge key. Not OpenAI, not OpenRouter.
GEMINI_API_KEY=
# FACT scrapes every cited page through Jina Reader.
JINA_API_KEY=

# ── DeepResearchGym judges (quality / KPR / citation) ─────────────────────────
# These use OPENAI_API_KEY above and honour OPENAI_BASE_URL, so a local
# vLLM/Ollama server can act as the judge.

# ── Official judge repo locations ─────────────────────────────────────────────
# Optional. Without these the harness looks in third_party/, then for sibling
# clones next to this repo. Check what it resolves with: adr doctor
# ADR_DRB_DIR=/path/to/deep_research_bench
# ADR_GYM_DIR=/path/to/deepresearchgym

# ── DeepResearchGym retrieval sandbox ─────────────────────────────────────────
# Corpus is chosen by route: fineweb -> /fineweb/search, clueweb22 -> /search.
# FineWeb access is immediate; ClueWeb22 needs a data-use agreement.
DEEPRESEARCHGYM_API_KEY=
DEEPRESEARCHGYM_BASE_URL=https://clueweb22.us
DEEPRESEARCHGYM_CORPUS=fineweb
# The hosted API exposes no archival fetch route; set this only for a local one.
# DEEPRESEARCHGYM_FETCH_URL=

# ── Live web search (DeepResearch Bench runs) ─────────────────────────────────
TAVILY_API_KEY=

# ── BrowseComp-Plus dense retriever (optional; BM25 is the default) ───────────
# ADR_BCP_RETRIEVER=dense
# ADR_BCP_DENSE=third_party/bcp_indexes/qwen3-embedding-0.6b
# ADR_BCP_EMBED_MODEL=qwen3-embedding:0.6b
# OLLAMA_HOST=http://127.0.0.1:11434
# GR_ORCHESTRATOR=none

# ── Orchestration policy rows (instrumented gpt-researcher fork) ──────────────
# GR_ORCHESTRATOR=none|topk|extractive|llmlingua|prompted|greedy|heuristic_stop
# GR_CONTEXT_BUDGET_TOKENS=50000
# greedy (marginal sub-question coverage x novelty, under the budget)
# GR_GREEDY_MIN_GAIN=0.0
# GR_GREEDY_LAMBDA=1.0
# heuristic_stop (default retention; stop when the coverage gain stays low)
# GR_STOP_GAIN_THRESHOLD=0.01
# GR_STOP_MIN_ROUNDS=2
# GR_STOP_PATIENCE=1
# GR_STOP_RETAIN=filter
