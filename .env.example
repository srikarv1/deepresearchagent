# Credentials and endpoints only. Every run, agent and judge parameter is YAML:
#   agent   configs/agents/gpt_researcher_{bench,gym,browsecomp_plus}.yaml
#   run     configs/gpt_researcher_*.yaml (dataset, search, budget, eval)
#   judges  configs/eval/{deep_research_bench,deep_research_gym,browsecomp_plus}.yaml
# Optional env fallbacks such as ADR_DRB_DIR / ADR_GYM_DIR / ADR_GR_DIR (repo
# locations), DEEPRESEARCHGYM_BASE_URL / _CORPUS / _FETCH_URL, ADR_BCP_* and
# OLLAMA_HOST all have a YAML key or an `adr` flag; see `adr doctor`.

# ── OpenAI-compatible endpoint ────────────────────────────────────────────────
# Agent LLMs and embeddings (fork), all Gym judges, and the DRB judge with
# judge.backend: openai. OPENAI_BASE_URL points at Azure Foundry, a local
# vLLM/Ollama server, or any other OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── DeepResearch Bench judges (RACE + FACT) ───────────────────────────────────
# Only with judge.backend: openrouter in configs/eval/deep_research_bench.yaml.
# OPENROUTER_API_KEY=
# FACT scrapes every cited page through Jina Reader (or judge.jina_reader: public).
JINA_API_KEY=

# ── DeepResearchGym retrieval sandbox ─────────────────────────────────────────
# Fork retriever (corpus: DEEPRESEARCHGYM_DATASET in the Gym agent YAML) and
# the harness gym search backend (search: in the run YAML).
DEEPRESEARCHGYM_API_KEY=

# ── Live web search (DeepResearch Bench runs) ─────────────────────────────────
TAVILY_API_KEY=

# ── TypeSafe (orchestration.policy: typesafe) ─────────────────────────────────
TYPESAFE_API_KEY=
